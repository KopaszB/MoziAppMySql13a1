<Window x:Class="MoziAppMySql13a1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoziAppMySql13a1"
        mc:Ignorable="d"
        Title="Mozi alkalmazás" Height="550" Width="900" MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="film.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--Bal oldal-->
        <StackPanel Margin="10">
            <TextBlock Text="Cím:"
                       FontSize="16"
                       FontWeight="DemiBold"/>
            <TextBox x:Name="tbx_cim"
                     FontSize="16"
                     Margin="0 5 0 10"/>

            <TextBlock Text="Hossz(perc):"
                       FontSize="16"
                       FontWeight="DemiBold"/>
            <TextBox x:Name="tbx_hossz"
                     FontSize="16"
                     Margin="0 5 0 10"/>

            <TextBlock Text="Korhatár:"
                       FontSize="16"
                       FontWeight="DemiBold"/>
            <ComboBox x:Name="cbx_korhatar"
                     FontSize="16"
                     Margin="0 5 0 10"/>

            <TextBlock Text="Műfaj:"
                       FontSize="16"
                       FontWeight="DemiBold"/>
            <ComboBox x:Name="cbx_mufaj"
                     FontSize="16"
                     Margin="0 5 0 10"/>
            
            <!--Gombok-->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="btn_hozzaad"
                        Content="Hozzáadás"
                        Width="150"
                        FontSize="16"
                        FontWeight="DemiBold"
                        Margin="5" Click="btn_hozzaad_Click"/>
                <Button x:Name="btn_modosit"
                        Content="Módosítás"
                        Width="150"
                        FontSize="16"
                        FontWeight="DemiBold"
                        Margin="5" Click="btn_modosit_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="btn_torles"
                        Content="Törlés"
                        Width="150"
                        FontSize="16"
                        FontWeight="DemiBold"
                        Margin="5" Click="btn_torles_Click"/>
                <Button x:Name="btn_frissites"
                        Content="Frissítés"
                        Width="150"
                        FontSize="16"
                        FontWeight="DemiBold"
                        Margin="5" Click="btn_frissites_Click"/>
            </StackPanel>
            <Separator Margin="10"/>
            <TextBlock Text="Szűrés korhatár szerint:"
                       FontSize="16"
                       FontWeight="DemiBold"/>
            <!--rádiógombok-->
            <StackPanel>
                <RadioButton x:Name="rbn_osszes"
                             GroupName="korhatar"
                             FontSize="16"
                             Content="Összes"
                             VerticalContentAlignment="Center"
                             Margin="3"
                             Checked="rbn_osszes_Checked"/>
                <RadioButton 
                             GroupName="korhatar"
                             FontSize="16"
                             Content="KN"
                             VerticalContentAlignment="Center"
                             Margin="3"
                    Checked="rbn_osszes_Checked"/>
                <RadioButton 
                             GroupName="korhatar"
                             FontSize="16"
                             Content="12"
                             VerticalContentAlignment="Center"
                             Margin="3"
                    Checked="rbn_osszes_Checked"/>
                <RadioButton 
                             GroupName="korhatar"
                             FontSize="16"
                             Content="16"
                             VerticalContentAlignment="Center"
                             Margin="3"
                    Checked="rbn_osszes_Checked"/>
                <RadioButton 
                             GroupName="korhatar"
                             FontSize="16"
                             Content="18"
                             VerticalContentAlignment="Center"
                             Margin="3"
                    Checked="rbn_osszes_Checked"/>
            </StackPanel>
        </StackPanel>
        
        <!--Jobb oldal-->
        <DataGrid x:Name="dg_filmek"
                  Grid.Column="1"
                  Margin="10"
                  SelectionChanged="dg_filmek_SelectionChanged"/>

    </Grid>
</Window>
